  m_Script: {fileID: 11500000, guid: 180ca76d1d9bb80459c7a831795ce96d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  ID: Hallway_11_Up_Candle
  Config: {fileID: 11400000, guid: 076ae4ea9db249b449b970116e50c642, type: 2}
  Card: {fileID: 4086836971517490514, guid: 8fcba838831040f4291c1e2f0d715209, type: 3}
  Title: Distant Ember
  Desc: "Something about that child\u2019s portrait feels different. Not the picture
    itself, but the way the room shifts around it\u2014like someone is pulling the
    strings. Maybe the child wants to say something. Or maybe he\u2019s the reason
    all of this is happening.\n\r\nIt\u2019s stifling in here, unbearably hot. And
    as much as I want answers, maybe survival matters more. Maybe leaving is the
    only choice that makes sense."

  m_Script: {fileID: 11500000, guid: 180ca76d1d9bb80459c7a831795ce96d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  ID: Hallway_07_Up_LightClick
  Config: {fileID: 11400000, guid: 438e564925a7af740874b96da8163231, type: 2}
  Card: {fileID: 6002595495615965257, guid: f429fc882bcb47940a875bbb7c6494dc, type: 3}
  Title: Flickering
  Desc: "I don\u2019t even know what floor I\u2019m on anymore. The elevator stopped,
    and the lamps here won\u2019t stop flickering. I\u2019ve seen enough horror movies
    to know what that means\u2014when the lights fail, something else is near.\n\nThey
    say spirits are just energy, invisible but heavy enough to disturb the world
    around them. Maybe that\u2019s why the bulbs stutter, why the air feels wrong.
    Whatever the reason, this hotel is alive with fear, and every step I take only
    proves it."

--- !u!114 &425500590
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 425500588}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 180ca76d1d9bb80459c7a831795ce96d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  ID: Hallway_14_Up_MidStairMirror
  Config: {fileID: 11400000, guid: d6e1ea015bec27843bf2cbc8ab7d0e4e, type: 2}
  Card: {fileID: 8854571019515086498, guid: 781bc77d34468554bb23347d901abaef, type: 3}
  Title: Penrose Stairs
  Desc: "The Penrose stairs\u2026 I\u2019ve heard the stories. A climb that never
    ends, a path that folds back on itself. No beginning, no end\u2014just the illusion
    of progress.\n\nAnd now, I think I\u2019m living it. The forest had no way out.
    The hotel feels like a world with no doors. I\u2019ve been here too long, caught
    in a loop I can\u2019t escape. Time slips away, and all I can think of is that
    cursed staircase, leading me nowhere."

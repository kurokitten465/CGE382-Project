  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 180ca76d1d9bb80459c7a831795ce96d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  ID: Hallway_02_Up_PhotoWall
  Config: {fileID: 11400000, guid: 991cb119ff3e814498e1fdcef73bc75c, type: 2}
  Card: {fileID: 3611705063195740478, guid: f043899ada9d4e24faeffb9e8353e6b6, type: 3}
  Title: Mystery Picture
  Desc: "Why do the portraits on this floor look so wrong? I had sensed it from the
    moment I entered\u2014their unsettling presence, the way they seemed to breathe
    in the silence. Each frame hung against the wall, yet the eyes within refused
    to stay still.\n\nThey were watching me. I could feel it. Every step I took,
    their gaze followed, piercing through the shadows. It was terrifying\u2026 and
    the longer I stared back, the more alive they seemed."

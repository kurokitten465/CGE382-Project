  m_Name: 
  m_EditorClassIdentifier: 
  ID: Hallway_10_Up_ClockGone
  Config: {fileID: 11400000, guid: 8dc5b4546f526354d8a777815dc2f9d8, type: 2}
  Card: {fileID: 4670835013599276096, guid: 606d534f59067d042bde5a9d0469a8bd, type: 3}
  Title: Blind Crime
  Desc: "Room 13. I hadn\u2019t seen it anywhere else in the hotel, and that alone
    made it feel wrong. Maybe something happened here once\u2014something the walls
    are still keeping. The door itself bears the mark of an axe, a wound that speaks
    of violence. Even the number looks tampered with, as if someone tried to hide
    what this room really was.\n\r\nI can\u2019t shake the feeling that behind this
    door lies a secret I was never meant to know. And yet\u2026 maybe it\u2019s the
    only way out."
